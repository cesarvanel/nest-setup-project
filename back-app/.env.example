PORT=4500
NODE_ENV=development
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
# Session cookie name (prefixed with __Host- in production)
SESSION_COOKIE_NAME=SETUP-SID
# Session lifetime (e.g. 5m, 1h, 7d)
SESSION_TTL=5m
# Comma-separated origins allowed to send cookie requests besides the app's own (empty when the front is served by this backend)
TRUSTED_ORIGINS=
MAINTENANCE=false
